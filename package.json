{
  "name": "antiscaler",
  "version": "0.3.0",
  "description": "Adaptive dev orchestration CLI — task DAG, content caching, runtime detection",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tracer": {
      "types": "./dist/tracer.d.ts",
      "import": "./dist/tracer.js"
    }
  },
  "bin": {
    "antiscaler": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsup",
    "test": "vitest",
    "test:run": "vitest run",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . && tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "prepublishOnly": "pnpm test:all && pnpm build"
  },
  "keywords": [
    "cli",
    "build",
    "orchestration",
    "task-runner",
    "caching",
    "dag"
  ],
  "author": "Bluesky Labs",
  "license": "MIT",
  "dependencies": {
    "@vitest/coverage-v8": "^4.1.6",
    "commander": "^14.0.3",
    "execa": "^9.6.1",
    "fast-glob": "^3.3.3",
    "jiti": "^2.6.1",
    "picocolors": "^1.1.1",
    "string-argv": "^0.3.2",
    "ts-morph": "^28.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@types/node": "^25.5.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
