{
  "name": "antiscale",
  "version": "0.1.0",
  "description": "Adaptive dev orchestration CLI — task DAG, content caching, runtime detection",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "antiscale": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/cli/index.ts --format esm --dts",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && vitest run"
  },
  "keywords": [
    "cli",
    "build",
    "orchestration",
    "task-runner",
    "caching",
    "dag"
  ],
  "author": "Bluesky Labs",
  "license": "MIT",
  "devDependencies": {
    "tsdown": "^0.21.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@types/node": "^25.5.0",
    "commander": "^14.0.3",
    "execa": "^9.6.1",
    "fast-glob": "^3.3.3",
    "jiti": "^2.6.1",
    "picocolors": "^1.1.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "zod": "^4.3.6"
  }
}
